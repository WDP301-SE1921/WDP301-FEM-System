# Sao chep file nay thanh .env va dien gia tri that.
# Moi bien phai co prefix EXPO_PUBLIC_ de duoc inline vao app bundle.
# CANH BAO: EXPO_PUBLIC_* nam trong bundle -> KHONG dat secret o day.

# BE chay cong 3000, prefix /api/v1. Dien thoai that dung IP LAN, Android emulator dung 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_ENV=development

# true: moi endpoint co route trong src/api/mocks duoc tra loi bang du lieu gia, ke ca endpoint BE da co.
# Hien tat ca endpoint app goi deu co mock. false = goi BE that toan bo.
# Khong duoc bat khi EXPO_PUBLIC_ENV=production.
EXPO_PUBLIC_API_MOCK=true
