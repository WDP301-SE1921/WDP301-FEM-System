# Bat buoc: copy file nay thanh .env truoc khi chay app, thieu EXPO_PUBLIC_API_URL thi app bao loi.
# Moi bien phai co prefix EXPO_PUBLIC_ de duoc inline vao app bundle.
# CANH BAO: EXPO_PUBLIC_* nam trong bundle -> KHONG dat secret o day.

# Mot so man hinh con dung mock (src/api/mocks) nen chua ho tro production.
EXPO_PUBLIC_ENV=development

# Dia chi BE kem prefix /api/v1, dung cho cac endpoint da noi BE that (src/api/wired-routes.ts).
# - Dien thoai that (Expo Go): IP LAN cua may chay BE, vd http://192.168.1.10:3000/api/v1
# - Android emulator: http://10.0.2.2:3000/api/v1
# - iOS simulator, web: http://localhost:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
